FROM node:22-trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openjdk-21-jre-headless \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g firebase-tools

WORKDIR /app
COPY firebase.json .firebaserc database.rules.json ./

EXPOSE 9000 4000

CMD ["firebase", "emulators:start", "--only", "database", "--project", "raven-traveler"]
